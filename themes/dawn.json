{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dawn",
  "author": "will",
  "themes": [
    {
      "name": "Dawn",
      "appearance": "light",
      "style": {
        "background": "#ececee",
        "editor.background": "#f6f6f8",
        "editor.gutter.background": "#f6f6f8",
        "editor.active_line.background": "#eeeef1",
        "editor.line_number": "#bcbcc4",
        "editor.active_line_number": "#55565c",
        "editor.wrap_guide": "#e3e3e6",
        "editor.highlighted_line.background": "#eeeef1",
        "editor.invisible": "#c4c4cc",

        "surface.background": "#f0f0f2",
        "elevated_surface.background": "#e7e7ea",
        "element.background": "#f0f0f2",
        "element.hover": "#e7e7ea",
        "element.active": "#dcdce0",
        "element.selected": "#dcdce0",
        "element.disabled": "#f0f0f2",

        "drop_target.background": "#3a72e022",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#e7e7ea",
        "ghost_element.active": "#dcdce0",
        "ghost_element.selected": "#dcdce0",
        "ghost_element.disabled": "#f0f0f2",

        "text": "#383a40",
        "text.muted": "#72747c",
        "text.placeholder": "#a6a7ad",
        "text.disabled": "#a6a7ad",
        "text.accent": "#3a72e0",

        "icon": "#383a40",
        "icon.muted": "#72747c",
        "icon.disabled": "#a6a7ad",
        "icon.placeholder": "#a6a7ad",
        "icon.accent": "#3a72e0",

        "selection": "#cdddf6",
        "editor.document_highlight.read_background": "#3a72e033",
        "editor.document_highlight.write_background": "#3a72e04d",

        "border": "#cbcbd1",
        "border.variant": "#cbcbd1",
        "border.focused": "#bdbdc4",
        "border.selected": "#3a72e0",
        "border.transparent": "#00000000",
        "border.disabled": "#e3e3e6",

        "tab_bar.background": "#ececee",
        "tab.inactive_background": "#ececee",
        "tab.active_background": "#f6f6f8",

        "toolbar.background": "#f6f6f8",
        "title_bar.background": "#ececee",
        "title_bar.inactive_background": "#ececee",
        "status_bar.background": "#ececee",
        "panel.background": "#f0f0f2",
        "panel.focused_border": "#bdbdc4",

        "pane.focused_border": "#bdbdc4",

        "scrollbar.thumb.background": "#bcbcc466",
        "scrollbar.thumb.hover_background": "#a6a7ad88",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "terminal.background": "#f6f6f8",
        "terminal.foreground": "#383a40",
        "terminal.bright_foreground": "#1f1f24",
        "terminal.dim_foreground": "#72747c",
        "terminal.ansi.black": "#e3e3e6",
        "terminal.ansi.bright_black": "#bcbcc4",
        "terminal.ansi.red": "#e85757",
        "terminal.ansi.bright_red": "#e85757",
        "terminal.ansi.green": "#2ba063",
        "terminal.ansi.bright_green": "#2ba063",
        "terminal.ansi.yellow": "#cf7f30",
        "terminal.ansi.bright_yellow": "#cf7f30",
        "terminal.ansi.blue": "#3a72e0",
        "terminal.ansi.bright_blue": "#3a72e0",
        "terminal.ansi.magenta": "#9558d8",
        "terminal.ansi.bright_magenta": "#9558d8",
        "terminal.ansi.cyan": "#199aa8",
        "terminal.ansi.bright_cyan": "#199aa8",
        "terminal.ansi.white": "#383a40",
        "terminal.ansi.bright_white": "#1f1f24",

        "link_text.hover": "#3a72e0",

        "conflict": "#cf7f30",
        "conflict.border": "#cf7f30",
        "conflict.background": "#cf7f3012",
        "created": "#2ba063",
        "created.border": "#2ba063",
        "created.background": "#2ba06312",
        "deleted": "#d47c7c",
        "deleted.border": "#d47c7c",
        "deleted.background": "#e8575712",
        "version_control.added": "#2ba063",
        "version_control.modified": "#d1a374",
        "version_control.deleted": "#e85757",
        "version_control.word_added": "#2ba06333",
        "version_control.word_deleted": "#e8575733",
        "version_control.conflict_marker.ours": "#2ba0631a",
        "version_control.conflict_marker.theirs": "#3a72e01a",
        "error": "#e04747",
        "error.border": "#e04747",
        "error.background": "#e0474722",
        "hidden": "#a6a7ad",
        "hidden.border": "#a6a7ad",
        "hidden.background": "#a6a7ad22",
        "hint": "#72747c",
        "hint.border": "#72747c",
        "hint.background": "#72747c22",
        "ignored": "#a6a7ad",
        "ignored.border": "#a6a7ad",
        "ignored.background": "#a6a7ad22",
        "info": "#199aa8",
        "info.border": "#199aa8",
        "info.background": "#199aa822",
        "modified": "#d1a374",
        "modified.border": "#d1a374",
        "modified.background": "#cf7f3012",
        "predictive": "#a6a7ad",
        "predictive.border": "#a6a7ad",
        "predictive.background": "#a6a7ad22",
        "renamed": "#3a72e0",
        "renamed.border": "#3a72e0",
        "renamed.background": "#3a72e022",
        "success": "#2ba063",
        "success.border": "#2ba063",
        "success.background": "#2ba06322",
        "unreachable": "#a6a7ad",
        "unreachable.border": "#a6a7ad",
        "unreachable.background": "#a6a7ad22",
        "warning": "#cf7f30",
        "warning.border": "#cf7f30",
        "warning.background": "#cf7f3022",

        "players": [
          { "cursor": "#3a72e0", "background": "#3a72e0", "selection": "#3a72e033" },
          { "cursor": "#2ba063", "background": "#2ba063", "selection": "#2ba06333" },
          { "cursor": "#9558d8", "background": "#9558d8", "selection": "#9558d833" },
          { "cursor": "#cf7f30", "background": "#cf7f30", "selection": "#cf7f3033" },
          { "cursor": "#199aa8", "background": "#199aa8", "selection": "#199aa833" },
          { "cursor": "#e85757", "background": "#e85757", "selection": "#e8575733" },
          { "cursor": "#bf8a1c", "background": "#bf8a1c", "selection": "#bf8a1c33" }
        ],

        "syntax": {
          "attribute": { "color": "#cf7f30" },
          "boolean": { "color": "#cf7f30" },
          "comment": { "color": "#8b7dbb", "font_style": "italic" },
          "comment.doc": { "color": "#8072b0", "font_style": "italic" },
          "constant": { "color": "#cf7f30" },
          "constructor": { "color": "#3a72e0" },
          "embedded": { "color": "#383a40" },
          "emphasis": { "color": "#e85757", "font_style": "italic" },
          "emphasis.strong": { "color": "#e85757", "font_weight": 700 },
          "enum": { "color": "#bf8a1c" },
          "function": { "color": "#3a72e0" },
          "function.builtin": { "color": "#199aa8" },
          "hint": { "color": "#72747c" },
          "keyword": { "color": "#9558d8" },
          "label": { "color": "#e85757" },
          "link_text": { "color": "#2ba063" },
          "link_uri": { "color": "#199aa8" },
          "number": { "color": "#cf7f30" },
          "operator": { "color": "#199aa8" },
          "predictive": { "color": "#a6a7ad" },
          "preproc": { "color": "#9558d8" },
          "primary": { "color": "#383a40" },
          "property": { "color": "#e85757" },
          "punctuation": { "color": "#383a40" },
          "punctuation.bracket": { "color": "#383a40" },
          "punctuation.delimiter": { "color": "#383a40" },
          "punctuation.list_marker": { "color": "#e85757" },
          "punctuation.special": { "color": "#199aa8" },
          "string": { "color": "#2ba063" },
          "string.escape": { "color": "#199aa8" },
          "string.regex": { "color": "#199aa8" },
          "string.special": { "color": "#cf7f30" },
          "string.special.symbol": { "color": "#e85757" },
          "tag": { "color": "#e85757" },
          "text.literal": { "color": "#2ba063" },
          "title": { "color": "#e85757", "font_weight": 700 },
          "type": { "color": "#bf8a1c" },
          "type.builtin": { "color": "#bf8a1c" },
          "variable": { "color": "#e85757" },
          "variable.special": { "color": "#e85757" },
          "variant": { "color": "#3a72e0" }
        }
      }
    }
  ]
}
