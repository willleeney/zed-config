{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "colorSource": "theme",
      "borderColorMode": "static",
      "modelLabel": "name",
      "viewportIndicators": false,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "\u258e",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "full",
          "contextFormat": "percent-total",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": false,
          "showCost": false,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "labeled",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "spinner": "braille",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "colorSource": "theme",
      "messages": {
        "custom": true,
        "values": [
          "Saut\u00e9ing\u2026",
          "Cooking\u2026",
          "Ionizing\u2026",
          "Zigzagging\u2026",
          "Razzle-dazzling\u2026",
          "Photosynthesizing\u2026",
          "Nucleating\u2026",
          "Brewing\u2026",
          "Combobulating\u2026",
          "Boogieing\u2026",
          "Befuddling\u2026",
          "Alchemizing\u2026",
          "Conjuring\u2026",
          "Baking\u2026",
          "Simmering\u2026",
          "Blanching\u2026"
        ]
      },
      "segments": {
        "tool": false,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "selectorBorders": {
      "enabled": false,
      "style": "zentui",
      "colorSource": "theme"
    },
    "footer": {
      "style": "starship",
      "colorSource": "theme",
      "modelLabel": "name",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 2,
          "separator": "dot",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": false,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": false,
            "modelInfo": false,
            "context": false,
            "tokens": false,
            "cost": true,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    }
  },
  "icons": {
    "mode": "auto"
  },
  "colors": {
    "workingLineHigh": "#9a8ddb",
    "editorModel": "#9a8ddb",
    "cwd": "#9a8ddb",
    "cost": "#9a8ddb",
    "contextNormal": "#9a8ddb",
    "extensionStatus": "#9a8ddb",
    "editorBorder": "#5a5d63",
    "editorAccent": "#9a8ddb",
    "editorThinking": "#9a8ddb"
  }
}
